# ==========================================
# AGENTIC PYTHON MASTERY - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env:
#   cp .env.example .env
# Fill in at least ONE of the free LLM keys below (Groq or Gemini recommended!)

# --- Option 1: Google Gemini (Free Tier at aistudio.google.com) ---
GEMINI_API_KEY=""

# --- Option 2: Groq Cloud (Free Tier at console.groq.com) ---
GROQ_API_KEY=""

# --- Option 3: OpenRouter (Free models at openrouter.ai) ---
OPENROUTER_API_KEY=""

# --- Option 4: NVIDIA NIM (1000 Free Credits at build.nvidia.com) ---
NVIDIA_API_KEY=""

# --- Option 5: Standard OpenAI (Optional, if you have credits) ---
OPENAI_API_KEY=""

# --- Option 6: Anthropic Claude (Optional, if you have credits) ---
ANTHROPIC_API_KEY=""

# --- Option 7: Local Ollama (No API Key Required!) ---
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Database Configuration (Defaults to local SQLite)
DATABASE_URL="sqlite:///./tasks.db"

# Capstone Application Settings
ENVIRONMENT="development"
LOG_LEVEL="INFO"
